{
  "name": "concord-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Concord Lite dashboard test harness",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium firefox",
    "test:a11y": "playwright test tests/e2e/a11y --project=chromium",
    "test:visual": "playwright test tests/e2e/visual --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual --project=chromium --update-snapshots",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^2.1.8"
  }
}
